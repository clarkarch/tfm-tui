{
  "name": "tfm-tui",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "compile": "bun build --compile src/index.ts assets/icons/*.svg --outfile dist/tfm",
    "compile:aot": "bun scripts/aot-build.ts aot dist/tfm-aot --trim",
    "compile:aot:plain": "bun scripts/aot-build.ts aot dist/tfm-aot",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "check": "biome check . && tsgo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@jsquash/avif": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@humanwhocodes/ico-to-png": "^1.1.0",
    "@opentui/core": "file:../opentui-fork/packages/core/dist",
    "dbus-next": "^0.10.2",
    "debug": "^4.4.3",
    "fflate": "^0.8.3",
    "heic-decode": "^2.1.0",
    "pngjs": "^7.0.0",
    "smol-toml": "^1.8.0",
    "utif2": "^4.1.0",
    "x11": "^4.3.1"
  }
}
